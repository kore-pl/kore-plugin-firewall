{
  "id": "firewall",
  "name": "防火墙/端口管理插件",
  "version": "0.3.1",
  "protocol": "kore.plugin.v1",
  "lifecycle": "lazy",
  "depth_level": "production",
  "entry": "bin/firewall",
  "capabilities": [
    "system:admin"
  ],
  "method_capabilities": {
    "firewall.status": "system:read",
    "firewall.rules": "system:read",
    "firewall.allowPort": "system:admin",
    "firewall.denyPort": "system:admin",
    "firewall.deleteRule": "system:admin",
    "firewall.enable": "system:admin",
    "firewall.disable": "system:admin",
    "firewall.ipList": "system:read",
    "firewall.recordFail": "system:admin",
    "firewall.bruteSet": "system:admin",
    "firewall.ipAllow": "system:admin",
    "firewall.ipDeny": "system:admin",
    "firewall.ipRemove": "system:admin",
    "firewall.config.get": "system:read",
    "firewall.config.set": "system:admin"
  },
  "triggers": [],
  "requires_kore": ">=0.1.0 <0.2.0",
  "resources": {
    "memory_mb": 6,
    "cpu_quota": "15%",
    "pids_max": 16
  },
  "depends_on": [],
  "conflicts": [],
  "scenario_tags": [
    "sec",
    "ops"
  ],
  "size_bytes": 2884064,
  "requires_root": true,
  "root_actions": [
    {
      "id": "ufw-status",
      "argv": [
        "ufw",
        "status",
        "verbose"
      ],
      "timeout_s": 10,
      "description": "读取 ufw 状态、默认入站策略与规则数"
    },
    {
      "id": "ufw-allow",
      "argv": [
        "ufw",
        "allow"
      ],
      "timeout_s": 10,
      "description": "放行端口（追加参数：如 22/tcp）",
      "irreversible": true
    },
    {
      "id": "ufw-deny",
      "argv": [
        "ufw",
        "deny"
      ],
      "timeout_s": 10,
      "description": "拒绝端口（追加参数：如 23/tcp）",
      "irreversible": true
    },
    {
      "id": "ufw-delete",
      "argv": [
        "ufw",
        "delete"
      ],
      "timeout_s": 10,
      "description": "按编号删除 ufw 规则（追加参数：规则编号）",
      "irreversible": true
    },
    {
      "id": "iptables-s",
      "argv": [
        "iptables",
        "-S"
      ],
      "timeout_s": 10,
      "description": "读取 iptables 规则集（只读）"
    },
    {
      "id": "ufw-enable",
      "argv": [
        "ufw",
        "enable"
      ],
      "timeout_s": 15,
      "description": "启用 ufw 防火墙",
      "irreversible": true
    },
    {
      "id": "ufw-disable",
      "argv": [
        "ufw",
        "disable"
      ],
      "timeout_s": 15,
      "description": "停用 ufw 防火墙（会失去包过滤保护）",
      "irreversible": true
    },
    {
      "id": "nft-list",
      "argv": [
        "nft",
        "list table inet kore_fw"
      ],
      "timeout_s": 10,
      "irreversible": false,
      "description": "列出 kore 自有 nft 表 kore_fw（只读，用于判断表是否就绪）"
    },
    {
      "id": "nft-init",
      "argv": [
        "nft",
        "add table inet kore_fw",
        ";",
        "add set inet kore_fw allow4 { type ipv4_addr ; flags interval ; }",
        ";",
        "add set inet kore_fw deny4 { type ipv4_addr ; flags interval,timeout ; }",
        ";",
        "add chain inet kore_fw input { type filter hook input priority -10 ; policy accept ; }",
        ";",
        "add rule inet kore_fw input ip saddr @allow4 counter accept",
        ";",
        "add rule inet kore_fw input ip saddr @deny4 counter drop"
      ],
      "timeout_s": 30,
      "irreversible": false,
      "description": "建 kore 自有表 kore_fw、白名单集合 allow4、黑名单集合 deny4 与 input base chain，并装「白名单 accept → 黑名单/封禁 drop」两条链规则（只动 kore_ 前缀的表，policy accept 不误伤其它规则）"
    },
    {
      "id": "nft-add-allow4",
      "argv": [
        "nft",
        "add element inet kore_fw allow4"
      ],
      "timeout_s": 15,
      "irreversible": false,
      "description": "加 IPv4 白名单元素（追加参数：{、地址/CIDR、}），命中后放行"
    },
    {
      "id": "nft-del-allow4",
      "argv": [
        "nft",
        "delete element inet kore_fw allow4"
      ],
      "timeout_s": 15,
      "irreversible": false,
      "description": "删 IPv4 白名单元素（追加参数：{、地址/CIDR、}）"
    },
    {
      "id": "nft-add-deny4",
      "argv": [
        "nft",
        "add element inet kore_fw deny4"
      ],
      "timeout_s": 15,
      "irreversible": false,
      "description": "加 IPv4 黑名单/临时封禁元素（追加参数：{、地址/CIDR、可选 timeout 与时长、}），命中后丢弃"
    },
    {
      "id": "nft-del-deny4",
      "argv": [
        "nft",
        "delete element inet kore_fw deny4"
      ],
      "timeout_s": 15,
      "irreversible": false,
      "description": "删 IPv4 黑名单/临时封禁元素（追加参数：{、地址/CIDR、}）"
    }
  ]
}
